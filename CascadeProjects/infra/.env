# CRX Constitutional Runtime Environment Configuration
# This is the SINGLE source of truth for all configuration
# Do not scatter configuration across multiple files

# PostgreSQL Configuration
POSTGRES_USER=crx
POSTGRES_PASSWORD=crx_dev_password
POSTGRES_DB=crx_kernel
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Ollama Configuration
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2

# Observability Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
LOKI_PORT=3100
TEMPO_PORT=3200
TEMPO_OTLP_PORT=4317

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Worker Configuration
WORKER_CONCURRENCY=4

# Scheduler Configuration
SCHEDULER_ENABLED=true

# Runtime Configuration
LOG_LEVEL=info
ENVIRONMENT=development

# Policy Configuration
POLICY_VERSION=0.1
POLICY_ENFORCEMENT=strict

# Replay Configuration
REPLAY_ENABLED=true
REPLAY_VALIDATION=strict

# Lineage Configuration
LINEAGE_TRACKING=full
LINEAGE_RETENTION_DAYS=365
