# PING Canonical Environment Configuration
# This is the single source of truth for all runtime configuration
# Every runtime inherits from this file
# No runtime should define configuration locally

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crx_runtime
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ============================================================================
# Qdrant Configuration
# ============================================================================
# Local Development
QDRANT_URL=http://localhost:6333
# Docker Environment
# QDRANT_URL=http://qdrant:6333
# Production Environment
# QDRANT_URL=https://67ee96e2-58e5-4476-aa17-a6e32a1e668d.sa-east-1-0.aws.cloud.qdrant.io

QDRANT_API_KEY=
QDRANT_COLLECTION=constitutional_memory

# ============================================================================
# Ollama Configuration
# ============================================================================
OLLAMA_BASE_URL=http://localhost:11434
# Docker Environment
# OLLAMA_BASE_URL=http://ollama:11434

OLLAMA_CHAT_MODEL=qwen3:latest
OLLAMA_REASONING_MODEL=qwen3:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# ============================================================================
# Repository Configuration
# ============================================================================
REPOSITORY_ROOT=C:\PING\repositories\drive
# Docker Environment
# REPOSITORY_ROOT=/workspace/repositories/drive

# ============================================================================
# Google Drive Configuration
# ============================================================================
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_ROOT=C:\PING\repositories\drive
# Docker Environment
# GOOGLE_DRIVE_ROOT=/workspace/repositories/drive

GOOGLE_CREDENTIALS=C:\PING\secrets\drive\credentials.json
GOOGLE_TOKEN=C:\PING\secrets\drive\token.json

# ============================================================================
# GitHub Configuration
# ============================================================================
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=C:\PING\secrets\github\github_app_private_key.pem
GITHUB_APP_WEBHOOK_SECRET=

# ============================================================================
# Observability Configuration
# ============================================================================
OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=http://otel:4317
JAEGER_URL=http://jaeger:16686
LOKI_URL=http://loki:3100

# ============================================================================
# Runtime Configuration
# ============================================================================
POLL_INTERVAL_SECONDS=5
LOG_LEVEL=INFO

# ============================================================================
# Service URLs (Internal)
# ============================================================================
CONSTITUTION_SERVICE_URL=http://constitution:8082
LEDGER_SERVICE_URL=http://ledger:8083
PROJECTION_SERVICE_URL=http://projection:8084
REPOSITORY_RUNTIME_URL=http://repo_runtime:8085
RETRIEVAL_SERVICE_URL=http://retrieval:8086
AGENT_RUNTIME_URL=http://agents:8087
SKILL_SERVICE_URL=http://skills:8088
FILESYSTEM_SERVICE_URL=http://filesystem:8089
WITNESS_SERVICE_URL=http://witness:8090
REPLAY_SERVICE_URL=http://replay:8091
GRAPH_SERVICE_URL=http://graph:8092
MEMORY_SERVICE_URL=http://memory:8093
SCHEDULER_SERVICE_URL=http://scheduler:8094
