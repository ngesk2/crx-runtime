{
  "extends": "eslint:recommended",
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "rules": {
    "no-replay-forbidden-imports": "error"
  },
  "overrides": [
    {
      "files": ["runtime/replay/**/*.ts"],
      "rules": {
        "no-replay-forbidden-imports": "error"
      }
    }
  ]
}
