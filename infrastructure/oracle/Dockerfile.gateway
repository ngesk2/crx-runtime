FROM node:18-alpine

# Build tools for native modules (tree-sitter)
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Install gateway dependencies
COPY gateway/package*.json ./gateway/
RUN cd gateway && npm ci --only=production

# Copy runtime trees (preserve directory structure for relative requires)
# gateway/ requires ../../ping-runtime/ and ../../runtime/
# ping-runtime/ requires ../../gateway/ (circular) and ../../runtime/
COPY gateway/ ./gateway/
COPY ping-runtime/ ./ping-runtime/
COPY runtime/ ./runtime/

# Infrastructure adapters required by runtime/ (e.g. physical_clock_adapter)
COPY infrastructure/physical_clock_adapter.js ./infrastructure/

# Generation manifest required by gateway/generated/generation_manifest_loader.js
COPY GENERATION_MANIFEST.yaml ./

# Database SQL files required by gateway/canonical_event_envelope.js
COPY database/ ./database/

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
USER nodejs
EXPOSE 8080
CMD ["node", "gateway/server.js"]
