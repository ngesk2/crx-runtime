# PING Infrastructure Environment Variables
# Copy this file to .env and fill in your secrets

# Oracle Cloud
ORACLE_SSH_KEY=~/.ssh/id_rsa
ORACLE_HOST=your-oracle-ip

# Fly.io
FLLY_TOKEN=your-fly-token

# Domain (optional)
DOMAIN_NAME=your-domain.com

# GitHub (optional)
GITHUB_PAT=ghp_...

# Database
POSTGRES_DB=ping
POSTGRES_USER=ping
POSTGRES_PASSWORD=CHANGE_ME

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME

# ACME (for SSL)
ACME_EMAIL=your-email@example.com

# OpenAI (optional)
OPENAI_API_KEY=sk-...

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-...

# Vault (optional)
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=your-vault-token

# Oracle Cloud Credentials (for OCI SDK)
OCI_TENANCY_ID=
OCI_USER_ID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=
OCI_REGION=
