POSTGRES_PORT=5432
POSTGRES_DB=crx_runtime
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# GitHub App Configuration
GITHUB_APP_ID=4147524
GITHUB_APP_PRIVATE_KEY_PATH=C:\PING\secrets\github\github_app_private_key.pem
GITHUB_APP_WEBHOOK_SECRET=

# Qdrant Configuration
QDRANT_URL=https://67ee96e2-58e5-4476-aa17-a6e32a1e668d.sa-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6YTIwODM2MGItNjhmNS00N2RmLWE0OWYtYTNiM2JiNTliMzYxIn0.NxvVTHcDckRzELXdX0TYgrmNcqN14J3-UP5AKzgb0po
QDRANT_COLLECTION=constitutional_memory

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face Configuration
HF_TOKEN=hf_your_access_token_here
HUGGINGFACE_HUB_TOKEN=hf_your_access_token_here

# Runtime Configuration
POLL_INTERVAL_SECONDS=5
LOG_LEVEL=INFO

# Repository Runtime Configuration
REPOSITORY_ROOT=C:\PING\repositories\drive

# Artifact Runtime
ARTIFACT_SCHEMA_VERSION=v1
ARTIFACT_COLLECTION=constitutional_artifacts
ARTIFACT_NAMESPACE=constitutional
ARTIFACT_CACHE_TTL=3600
ARTIFACT_MAX_SIZE_MB=64
ARTIFACT_COMPRESSION=zstd
ARTIFACT_STORAGE_BACKEND=postgres

# Constitutional Runtime
CONSTITUTION_VERSION=v1
CONSTITUTION_NAMESPACE=constitutional
CONSTITUTION_SERVICE_URL=http://constitution:8082

AUTHORITY_ENGINE=postgres
AUTHORITY_CACHE_TTL=300
AUTHORITY_MAX_DEPTH=64

WITNESS_SERVICE_URL=http://witness:8090
WITNESS_HASH_ALGORITHM=sha256

REPLAY_SERVICE_URL=http://replay:8091
REPLAY_MAX_DEPTH=1024
REPLAY_BATCH_SIZE=100

PROJECTION_SERVICE_URL=http://projection:8084
PROJECTION_BATCH_SIZE=100

# Event Runtime
EVENT_SCHEMA_VERSION=v1
EVENT_RETENTION_DAYS=3650
EVENT_BATCH_SIZE=100
EVENT_MAX_PAYLOAD_MB=16
EVENT_COMPRESSION=zstd
EVENT_SIGNATURES=true

# Ledger Runtime
LEDGER_SERVICE_URL=http://ledger:8083
LEDGER_HASH_ALGORITHM=sha256
LEDGER_APPEND_ONLY=true
LEDGER_VERIFY_ON_STARTUP=true

# Retrieval Runtime
RETRIEVAL_SERVICE_URL=http://retrieval:8086

RETRIEVAL_TOP_K=20
RETRIEVAL_MAX_RESULTS=100

CONTEXT_PACK_MAX_TOKENS=24000
CONTEXT_PACK_MAX_CITATIONS=25

LINEAGE_MAX_DEPTH=32
AUTHORITY_MAX_DEPTH=32
GRAPH_MAX_DEPTH=6

# Qdrant Collections
QDRANT_COLLECTION_CONSTITUTION=constitutional_memory
QDRANT_COLLECTION_ARTIFACTS=constitutional_artifacts
QDRANT_COLLECTION_CODE=repository_symbols
QDRANT_COLLECTION_EVENTS=event_memory
QDRANT_COLLECTION_OBSERVATIONS=observations

QDRANT_DISTANCE=Cosine
QDRANT_EMBEDDING_DIMENSIONS=1024
QDRANT_SNAPSHOT_INTERVAL=24h
QDRANT_PAYLOAD_INDEXING=true

# Ollama Runtime
OLLAMA_CHAT_MODEL=qwen3:latest
OLLAMA_REASONING_MODEL=qwen3:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_PARALLEL_REQUESTS=4
OLLAMA_GPU_LAYERS=-1
OLLAMA_KEEP_ALIVE=10m

OLLAMA_ENABLE_TOOLS=true
OLLAMA_ENABLE_STRUCTURED_OUTPUT=true

# Repository Intelligence
REPOSITORY_SYMBOL_COLLECTION=repository_symbols
REPOSITORY_RELATIONSHIP_COLLECTION=repository_relationships

REPOSITORY_INCREMENTAL_INDEX=true
REPOSITORY_MAX_FILE_MB=20
REPOSITORY_GRAPH_DEPTH=12

REPOSITORY_RUNTIME_URL=http://repo_runtime:8085

# Graph Runtime
GRAPH_SERVICE_URL=http://graph:8092

GRAPH_MAX_NEIGHBORS=100
GRAPH_TRAVERSAL_DEPTH=8
GRAPH_CACHE_TTL=600

# Agent Runtime
AGENT_RUNTIME_URL=http://agents:8087

AGENT_MAX_CONCURRENT=32
AGENT_DEFAULT_TIMEOUT=300
AGENT_MEMORY_LIMIT_MB=4096

AGENT_AUTHORITY_ENFORCEMENT=true
AGENT_REQUIRE_WITNESS=true

# Skills Runtime
SKILL_SERVICE_URL=http://skills:8088

SKILL_REGISTRY_VERSION=v1
SKILL_CACHE_TTL=600

# Google Drive Integration
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_ROOT=C:\PING\repositories\drive
GOOGLE_CREDENTIALS=C:\PING\integrations\google-drive\credentials.json
GOOGLE_TOKEN=C:\PING\integrations\google-drive\token.json

# Filesystem Runtime
FILESYSTEM_SERVICE_URL=http://filesystem:8089

FILESYSTEM_INDEX_BATCH=100
FILESYSTEM_WATCH_DEBOUNCE_MS=500
FILESYSTEM_HASH_ALGORITHM=sha256

# Object Store
OBJECT_STORE_PROVIDER=filesystem
OBJECT_STORE_ROOT=/storage/objects

OBJECT_RETENTION_DAYS=3650
OBJECT_HASH_ALGORITHM=sha256
OBJECT_COMPRESSION=zstd

# Memory Runtime
MEMORY_SERVICE_URL=http://memory:8093

MEMORY_CACHE_SIZE_MB=2048
MEMORY_VECTOR_BACKEND=qdrant
MEMORY_GRAPH_BACKEND=neo4j
MEMORY_AUTHORITY_BACKEND=postgres

# Observability
OTEL_ENABLED=true

OTEL_EXPORTER_ENDPOINT=http://otel:4317

JAEGER_URL=http://jaeger:16686

LOKI_URL=http://loki:3100

# Scheduler
SCHEDULER_SERVICE_URL=http://scheduler:8094

CRON_TIMEZONE=UTC

WORKER_HEARTBEAT_SECONDS=15

# API Contracts (Reserved Internal Endpoints)
CONSTITUTION_SERVICE_URL=http://constitution:8082
LEDGER_SERVICE_URL=http://ledger:8083
PROJECTION_SERVICE_URL=http://projection:8084
REPO_RUNTIME_URL=http://repo_runtime:8085
RETRIEVAL_SERVICE_URL=http://retrieval:8086
AGENT_RUNTIME_URL=http://agents:8087
SKILL_SERVICE_URL=http://skills:8088
FILESYSTEM_SERVICE_URL=http://filesystem:8089
WITNESS_SERVICE_URL=http://witness:8090
REPLAY_SERVICE_URL=http://replay:8091
GRAPH_SERVICE_URL=http://graph:8092
MEMORY_SERVICE_URL=http://memory:8093
SCHEDULER_SERVICE_URL=http://scheduler:8094
